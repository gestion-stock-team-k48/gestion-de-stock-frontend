import { axiosInstance } from '../../../core/api/axiosInstance'
import type { CommandeFournisseurRequest } from '../types'
import type { EtatCommande } from '../../../core/types/index'

export const commandeFournisseursApi = {
  getAll: () => axiosInstance.get('/commandes-fournisseur'),
  getById: (id: number) => axiosInstance.get(`/commandes-fournisseur/${id}`),
  getHistoric: (idFournisseur: number) => axiosInstance.get(`/commandes-fournisseur/fournisseur/${idFournisseur}`),
  create: (data: CommandeFournisseurRequest) => axiosInstance.post('/commandes-fournisseur', data),
  update: (id: number, data: CommandeFournisseurRequest) => axiosInstance.put(`/commandes-fournisseur/${id}`, data),
  updateEtat: (id: number, etatCommande: EtatCommande) =>
    axiosInstance.patch(`/commandes-fournisseur/${id}/etat`, { etatCommande }),
  delete: (id: number) => axiosInstance.delete(`/commandes-fournisseur/${id}`),
}